# Copy to .env (never commit .env — it's gitignored). chmod 600 .env
# Device scripts read these; pairing commands fill in the tokens for you.

# Philips Hue Bridge (local) — python src/devices/hue.py pair
HUE_BRIDGE_IP=
HUE_APP_KEY=

# HomeWizard P1 meter (local) — python src/devices/homewizard.py pair
HW_P1_IP=
HW_P1_TOKEN=

# Bosch Home Connect (cloud) — python src/devices/bosch.py auth
BOSCH_CLIENT_ID=
BOSCH_ACCESS_TOKEN=
BOSCH_REFRESH_TOKEN=

# Telegram bridge (optional) — @BotFather token, then `python telegram_bot.py setup`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Aqara Open API (cloud) — see src/devices/aqara.py docstring
AQARA_DOMAIN=
AQARA_APP_ID=
AQARA_APP_KEY=
AQARA_KEY_ID=
AQARA_TOKEN=
